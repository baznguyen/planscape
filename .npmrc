# Always install devDependencies, even when NODE_ENV=production is set in the
# shell — which it is on at least one machine here, and which silently makes
# `npm install` skip typescript. Next then cannot read tsconfig.json, the "@/*"
# path aliases stop resolving, and the build fails with "Can't resolve
# @/components/Ui" — an error that points nowhere near the cause.
include=dev
