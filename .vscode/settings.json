{
  // The model is metric and every number in src/lib/model is metres. Ruler at
  // 90 because that is where the comment style in this repo wraps.
  "editor.rulers": [90],
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",

  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist-test": true,
    "**/tools/views/*.png": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true
  },

  // sheetLines.ts and planNotes.ts are generated by tools/*.py. Editing them by
  // hand is how the model stops matching the drawing.
  "files.readonlyInclude": {
    "src/lib/model/sheetLines.ts": true,
    "src/lib/model/planNotes.ts": true
  },

  "python.analysis.extraPaths": ["tools"],
  "[python]": { "editor.tabSize": 4 },
  "[markdown]": { "editor.wordWrap": "on", "editor.quickSuggestions": { "other": false } }
}
